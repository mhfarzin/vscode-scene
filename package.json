{
  "name": "vscode-screensaver",
  "displayName": "VS Code Screensaver",
  "description": "Beautiful relaxing animated scenes for VS Code",
  "publisher": "MH Farzin",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Screensaver",
      "properties": {
        "vscode-screensaver.screen": {
          "type": "string",
          "enum": [
            "stars",
            "sky-pilot"
          ],
          "enumDescriptions": [
            "Twinkling stars drifting upward (Canvas2D).",
            "Sky scene with drifting clouds and flying airplanes (Pixi.js)."
          ],
          "default": "sky-pilot",
          "description": "The screensaver screen to display.",
          "scope": "window"
        }
      }
    },
    "commands": [
      {
        "command": "vscode-screensaver.start",
        "title": "Start Screensaver",
        "icon": "$(play)"
      },
      {
        "command": "vscode-screensaver.stop",
        "title": "Stop Screensaver",
        "icon": "$(stop)"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "vscode-screensaver.view",
          "name": "Screensaver"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "pixi.js": "^8.19.0"
  }
}
