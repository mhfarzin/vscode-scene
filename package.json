{
  "name": "vscode-screensaver",
  "displayName": "VS Code Screensaver",
  "description": "Beautiful relaxing animated scenes for VS Code",
  "publisher": "MhFarzin",
  "version": "0.1.2",
  "icon": "assets/icons/icon.png",
  "keywords": [
    "screensaver",
    "animation",
    "animated",
    "stars",
    "starfield",
    "sky",
    "airplane",
    "pixi",
    "ambient"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mhfarzin/vscode-screensaver"
  },
  "bugs": {
    "url": "https://github.com/mhfarzin/vscode-screensaver/issues"
  },
  "homepage": "https://github.com/mhfarzin/vscode-screensaver",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "VS Code Screensaver",
      "properties": {
        "vscode-screensaver.screen": {
          "type": "string",
          "enum": [
            "stars",
            "sky-pilot"
          ],
          "description": "The screensaver screen to display.",
          "scope": "window",
          "default": "sky-pilot"
        }
      }
    },
    "commands": [
      {
        "command": "vscode-screensaver.start",
        "title": "VS Code Screensaver: Start",
        "icon": "$(play)"
      },
      {
        "command": "vscode-screensaver.stop",
        "title": "VS Code Screensaver: Stop",
        "icon": "$(stop)"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "vscode-screensaver.view",
          "name": "VS Code Screensaver",
          "icon": ""
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "serve:test": "node scripts/serve-test.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "pixi.js": "^8.19.0"
  }
}
